# Copy this file to  keys.env  and fill in your values.
# keys.env is gitignored, so nothing here is ever committed.
# Loaded automatically by run_daily.sh for scheduled (cron) runs.

# --- MEXC API keys (required for live trading) ---
export MEXC_API_KEY="your_key_here"
export MEXC_API_SECRET="your_secret_here"

# --- Phone notifications (optional) ---
# ntfy: install the ntfy phone app, subscribe to a long random topic name,
# and put the SAME name here. You'll get a push every time the bot trades.
export NTFY_TOPIC=""
# Or use Telegram instead (see notify.py for setup):
# export TELEGRAM_BOT_TOKEN=""
# export TELEGRAM_CHAT_ID=""
