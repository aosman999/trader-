# Copy this file to  keys.env  and fill in your values.
# keys.env is gitignored, so nothing here is ever committed, and updates
# (./update.sh) never overwrite it. ALL your settings live here -- you should
# never have to edit the .py files.
# Loaded automatically by run_daily.sh for scheduled runs; run `source keys.env`
# to load it into your own terminal for manual runs.

# --- MEXC API keys (required for live trading) ---
export MEXC_API_KEY="your_key_here"
export MEXC_API_SECRET="your_secret_here"

# --- Where to trade, and whether it's live ---
export BROKER="paper"          # paper | mexc | mexc_futures
export DRY_RUN="true"          # "false" = place REAL orders. Keep "true" to rehearse.
export LEVERAGE="2"            # futures leverage (hard-capped at 10)

# --- Phone notifications ---
# Install the ntfy app, subscribe to a long random topic, put the SAME name here.
export NTFY_TOPIC=""
export NOTIFY_STATUS_MINUTES="15"   # send a status push this often (0 = off)
# Telegram instead (optional): see notify.py
# export TELEGRAM_BOT_TOKEN=""
# export TELEGRAM_CHAT_ID=""

# --- Optional tuning (defaults shown; uncomment to change) ---
# export WATCHLIST="AUTO"       # AUTO = trade any MEXC coin; or "BTC,ETH,SOL"
# export MAX_SCAN="30"          # in AUTO mode, scan this many most-active coins
# export INTERVAL="1m"          # 1m,5m,15m,30m,1h,4h,1d,1w
# export MIN_TF_AGREE="6"       # how many timeframes must agree to buy (of 8)
# export USE_SR="true"          # support/resistance filter: need room to run
# export SR_MIN_ROOM="0.03"     # required clear space to the nearest level (3%)
# export MAX_IDLE_DAYS="3"      # never sit idle longer than this (0 = off)
# export FUTURES_SIGNALS="true" # text futures trades to place by hand (spot still auto)
# export SIGNAL_TP_PCT="0.16"   # take-profit % shown in the futures signal
# export TARGET_USD="0"         # goal: alert when TOTAL (spot+futures) reaches this (0 = off)
# export TARGET_DAYS="21"        # deadline tracker (days) -- progress only, forces nothing
# export TARGET_STOP="true"      # stop trading once the goal is hit (default: keep trading)
# export FLOOR_USD="12"         # capital floor the bot protects
# export STOP_LOSS_PCT="0.04"   # 4% stop
# export TRAIL_PCT="0.05"       # trailing take-profit: exit 5% off the peak
